`timescale 1ns / 1ps

module counter_tb;

    // Testbench signals
    reg        clk;
    reg        rst_n;
    reg        en;
    reg        up_down;
    wire [3:0] count;

    // Instantiate Design Under Test (DUT)
    counter uut (
        .clk(clk),
        .rst_n(rst_n),
        .en(en),
        .up_down(up_down),
        .count(count)
    );

    // Clock Generation (50MHz clock -> 20ns period)
    always begin
        clk = 1'b0;
        #10;
        clk = 1'b1;
        #10;
    end

    initial begin
        // Monitor signals in the console terminal
        $monitor("Time=%0dt | Reset=%b | Enable=%b | Up/Down=%b | Count=%d (%b)", 
                 $time, rst_n, en, up_down, count, count);

        // Initialize Inputs
        rst_n   = 1'b0; // Apply system reset
        en      = 1'b0;
        up_down = 1'b1;
        #25;            // Wait for 25ns (releases after a rising edge)

        // Release Reset
        rst_n   = 1'b1;
        #20;

        // --- Test Case 1: Count Up ---
        en      = 1'b1;
        up_down = 1'b1;
        #100;           // Let it count up for 5 clock cycles

        // --- Test Case 2: Disable Counter ---
        en      = 1'b0;
        #40;            // Holds value for 2 clock cycles

        // --- Test Case 3: Count Down ---
        en      = 1'b1;
        up_down = 1'b0;
        #120;           // Let it count down for 6 clock cycles

        // --- Test Case 4: Asynchronous Reset Test ---
        rst_n   = 1'b0; // Strike reset abruptly mid-cycle
        #20;
        
        $finish;        // Terminate simulation
    end

endmodule
